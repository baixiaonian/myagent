{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "scripts/**/*.mjs",
      "tests/**",
      "config/**",
      "*.json",
      "*.ts",
      "!!**/dist",
      "!!**/node_modules",
      "!!research",
      "!!diagrams",
      "!!**/.cache",
      "!!**/.git"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}

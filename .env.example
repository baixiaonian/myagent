# 本地服务环境变量示例：只列启动选项，模型连接与密钥请在 Web 设置中配置。
# 本文件不会被自动读取。使用 shell 导出配置；密钥只在 Web 设置中填写。
# MYAGENT_DATA_DIR=/absolute/path/to/myagent-data
# PORT=3000
# MYAGENT_WEB_PORT=5173
# 每次运行启动时固定资源配置，不限制固定模型调用轮数。
# MYAGENT_MODEL_TIMEOUT_MS=120000
# MYAGENT_TOOL_TIMEOUT_MS=30000
# 单个命令进程的默认时限，不是任务总时限。
# MYAGENT_COMMAND_TIMEOUT_MS=600000
# 兼容的附加字符上限，默认不启用；不是 token，模型窗口请在设置页配置。
# MYAGENT_CONTEXT_CHARACTERS=32000
# 近期原文保留偏好，较早记录进入摘要。
# MYAGENT_HISTORY_TURNS=3
# MYAGENT_TOOL_RESULT_CHARACTERS=8000
# 已停用 MYAGENT_RUN_TIMEOUT_MS / MYAGENT_OUTPUT_CHARACTERS；即使残留也不生效。

# 默认任务目录根；应与数据/凭证目录分离。
# MYAGENT_WORKSPACE_ROOT=/absolute/path/to/workspaces

# Skill 用户来源独立于数据与凭证目录；仅扫描此目录的技能，不自动接入其他应用。
# MYAGENT_SKILL_ROOT=/absolute/path/to/skills
# MYAGENT_SKILL_FILE_BYTES=20971520
# MYAGENT_SKILL_PACKAGE_BYTES=104857600
# MYAGENT_SKILL_FILES=10000

# 用户级 Hook 的相对脚本包路径基准；配置位于数据目录 hooks.json。
# MYAGENT_HOOK_ROOT=/absolute/path/to/MyAgent/Hooks

# 轻量团队：未关闭成员数与全局模型请求并发（包含摘要）。
MYAGENT_TEAM_MAX_MEMBERS=8
MYAGENT_TEAM_MODEL_CONCURRENCY=4

# 原始材料受保护存储；调试开关通过页面保存，默认关闭。
# MYAGENT_CAPTURE_FILE_BYTES=20971520
# MYAGENT_CAPTURE_TOTAL_BYTES=1073741824
# 可选 OTLP 只导出元数据；导出凭证不会传入 Worker。
# MYAGENT_OTLP_ENABLED=1
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer replace-me

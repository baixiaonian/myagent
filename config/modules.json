{
  "schemaVersion": 1,
  "modules": [
    {
      "name": "@myagent/contracts",
      "path": "packages/contracts",
      "responsibility": "聊天、工作区、文档版本、执行调用、授权、进程和结果 DTO",
      "status": "tool-execution-v1",
      "allowedDependencies": []
    },
    {
      "name": "@myagent/sdk",
      "path": "packages/sdk",
      "responsibility": "HTTP 命令、v1/v2/v3/v4/v5/v6 SSE 去重与执行投影",
      "status": "tool-execution-v1",
      "allowedDependencies": ["@myagent/contracts"]
    },
    {
      "name": "@myagent/kernel",
      "path": "packages/kernel",
      "responsibility": "单一自主循环、上下文/工具端口、纯 Policy 与资源调度",
      "status": "tool-execution-v1",
      "allowedDependencies": ["@myagent/contracts"]
    },
    {
      "name": "@myagent/state",
      "path": "packages/state",
      "responsibility": "聊天与执行事实仓储、文档文件端口、检查点和私有配置契约",
      "status": "tool-execution-v1",
      "allowedDependencies": ["@myagent/contracts"]
    },
    {
      "name": "@myagent/content",
      "path": "packages/content",
      "responsibility": "记忆条目校验、来源协议、概览预算与读取端口",
      "status": "memory-v1",
      "allowedDependencies": ["@myagent/contracts"]
    },
    {
      "name": "@myagent/application",
      "path": "packages/application",
      "responsibility": "运行生命周期、受控执行、人工文档保存、命令策略、审批、隔离核对与 MCP 配置、长期记忆整理与插件生命周期",
      "status": "tool-execution-v1",
      "allowedDependencies": [
        "@myagent/contracts",
        "@myagent/kernel",
        "@myagent/state",
        "@myagent/content",
        "@myagent/extensions",
        "@myagent/orchestration",
        "@myagent/observability"
      ]
    },
    {
      "name": "@myagent/extensions",
      "path": "packages/extensions",
      "responsibility": "Skill/Hook 协议、插件清单兼容与包来源端口",
      "status": "plugins-v1",
      "allowedDependencies": ["@myagent/contracts", "@myagent/kernel"]
    },
    {
      "name": "@myagent/orchestration",
      "path": "packages/orchestration",
      "responsibility": "轻量团队调度、等待与模型调用公平队列",
      "status": "teams-v1",
      "allowedDependencies": ["@myagent/contracts"]
    },
    {
      "name": "@myagent/observability",
      "path": "packages/observability",
      "responsibility": "观测端口、关联字段、定点计价和用量聚合",
      "status": "observability-v1",
      "allowedDependencies": ["@myagent/contracts"]
    },
    {
      "name": "@myagent/adapters",
      "path": "packages/adapters",
      "responsibility": "双协议模型、SQLite v7、原生沙箱、Shell 分析、文件/命令与人工文档原子保存、MCP 和凭证",
      "status": "tool-execution-v1",
      "allowedDependencies": [
        "@myagent/contracts",
        "@myagent/kernel",
        "@myagent/state",
        "@myagent/content",
        "@myagent/observability",
        "@myagent/extensions"
      ]
    },
    {
      "name": "@myagent/testing",
      "path": "packages/testing",
      "responsibility": "未来的 FakeModel / FakeTool / FakeClock",
      "status": "scaffold",
      "allowedDependencies": ["@myagent/contracts", "@myagent/kernel"]
    },
    {
      "name": "@myagent/web",
      "path": "apps/web",
      "responsibility": "聊天、项目文档富文本编辑、MCP 设置、审批、核对和结果分页",
      "status": "tool-execution-v1",
      "allowedDependencies": ["@myagent/sdk"]
    },
    {
      "name": "@myagent/server",
      "path": "apps/server",
      "responsibility": "本机 API/SSE 与唯一装配点、恢复、维护和静态托管",
      "status": "tool-execution-v1",
      "allowedDependencies": [
        "@myagent/application",
        "@myagent/kernel",
        "@myagent/state",
        "@myagent/content",
        "@myagent/adapters",
        "@myagent/extensions",
        "@myagent/orchestration",
        "@myagent/observability",
        "@myagent/contracts"
      ]
    },
    {
      "name": "@myagent/cli",
      "path": "apps/cli",
      "responsibility": "通过 SDK 访问应用；当前仅启动提示",
      "status": "scaffold",
      "allowedDependencies": ["@myagent/sdk"]
    },
    {
      "name": "@myagent/worker",
      "path": "apps/worker",
      "responsibility": "独立 IPC 监督器与原生沙箱执行入口",
      "status": "tool-execution-v1",
      "allowedDependencies": ["@myagent/contracts", "@myagent/adapters"]
    }
  ]
}

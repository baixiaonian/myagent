="585" y="1190"/><mxPoint x="585" y="1260"/></Array></mxGeometry></mxCell><mxCell id="e10" value="协议调用" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=0" edge="1" parent="1" source="execution" target="connectors"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="1190"/><mxPoint x="965" y="1260"/></Array></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=1" edge="1" parent="1" source="execution" target="tools"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="1145"/><mxPoint x="395" y="1145"/><mxPoint x="395" y="907"/><mxPoint x="420" y="907"/></Array></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=1" edge="1" parent="1" source="tools" target="runtime"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="845"/><mxPoint x="405" y="845"/><mxPoint x="405" y="507"/><mxPoint x="420" y="507"/></Array></mxGeometry></mxCell><mxCell id="e13" value="提交" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=1" edge="1" parent="1" source="runtime" target="session"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="470"/><mxPoint x="335" y="470"/></Array></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=1" edge="1" parent="1" source="context" target="task"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="650"/><mxPoint x="375" y="650"/><mxPoint x="375" y="650"/><mxPoint x="335" y="650"/></Array></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=1" edge="1" parent="1" source="context" target="content"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="700"/><mxPoint x="360" y="700"/><mxPoint x="360" y="830"/><mxPoint x="335" y="830"/></Array></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=1" edge="1" parent="1" source="session" target="store"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="550"/><mxPoint x="20" y="550"/><mxPoint x="20" y="1120"/><mxPoint x="35" y="1120"/></Array></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=1" edge="1" parent="1" source="task" target="store"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="710"/><mxPoint x="10" y="710"/><mxPoint x="10" y="1170"/><mxPoint x="35" y="1170"/></Array></mxGeometry></mxCell><mxCell id="e18" value="版本内容 / 索引" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=0" edge="1" parent="1" source="content" target="store"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="915"/><mxPoint x="185" y="1070"/></Array></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=1" edge="1" parent="1" source="extensions" target="runtime"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1205" y="495"/><mxPoint x="1180" y="495"/><mxPoint x="1180" y="450"/><mxPoint x="1130" y="450"/></Array></mxGeometry></mxCell><mxCell id="e20" value="提供目录与扩展点" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=1" edge="1" parent="1" source="extensions" target="skills"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1355" y="575"/><mxPoint x="1355" y="635"/></Array></mxGeometry></mxCell><mxCell id="e21" value="凭证引用" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=1" edge="1" parent="1" source="credentials" target="execution"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1355" y="945"/><mxPoint x="1355" y="1020"/><mxPoint x="1100" y="1020"/><mxPoint x="1100" y="1100"/></Array></mxGeometry></mxCell><mxCell id="ui" value="&lt;b&gt;01  产品入口 · Web / CLI / SDK&lt;/b&gt;&lt;br&gt;对话与任务列表 · 运行进度 · 人工交互 · 产物预览与下载" style="rounded=1;html=1;fillColor=#e9f4ed;strokeColor=#568b75;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="440" y="80" width="660" height="100" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;02  Application · 应用服务&lt;/b&gt;&lt;br&gt;身份与工作区 / 命令幂等 / 会话写入队列&lt;br&gt;start · steer · followUp · cancel · resume · 事件订阅" style="rounded=1;html=1;fillColor=#e9f4ed;strokeColor=#568b75;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="440" y="235" width="660" height="110" as="geometry"/></mxCell><mxCell id="runtime" value="&lt;b&gt;03  Agent Runtime · 唯一运行循环&lt;/b&gt;&lt;br&gt;Run / Step 状态机 · Inbox · 预算与停止条件 · 取消树&lt;br&gt;每步冻结配置、工具目录与上下文版本；完成后检查验收" style="rounded=1;html=1;fillColor=#e9f4ed;strokeColor=#568b75;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="420" y="430" width="710" height="115" as="geometry"/></mxCell><mxCell id="context" value="&lt;b&gt;04  Context Builder&lt;/b&gt;&lt;br&gt;指令层级 / 历史分支 / Skill&lt;br&gt;检索与记忆 / token 预算&lt;br&gt;压缩摘要 + 来源引用 + 快照" style="rounded=1;html=1;fillColor=#e9f4ed;strokeColor=#568b75;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="420" y="605" width="330" height="125" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;05  Model Gateway&lt;/b&gt;&lt;br&gt;能力表 / 模型路由 / 厂商适配&lt;br&gt;统一消息、工具调用与流事件&lt;br&gt;超时 / 重试 / 用量与成本" style="rounded=1;html=1;fillColor=#e9f4ed;strokeColor=#568b75;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="800" y="605" width="330" height="125" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;06  Tool System&lt;/b&gt;&lt;br&gt;Registry / Schema / Hook 管线&lt;br&gt;最终参数冻结 / 资源锁&lt;br&gt;有界并发 / 结果归并与截断" style="rounded=1;html=1;fillColor=#fff2e4;strokeColor=#ba864b;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="420" y="810" width="330" height="135" as="geometry"/></mxCell><mxCell id="policy" value="&lt;b&gt;07  Policy + Interaction&lt;/b&gt;&lt;br&gt;主体、资源、效果与授权范围&lt;br&gt;allow / deny / ask；等待落库&lt;br&gt;审批绑定参数摘要；恢复再校验" style="rounded=1;html=1;fillColor=#fff2e4;strokeColor=#ba864b;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="800" y="810" width="330" height="135" as="geometry"/></mxCell><mxCell id="execution" value="&lt;b&gt;08  Execution Gateway · 执行网关&lt;/b&gt;&lt;br&gt;能力授权 / workspaceRef / deadline / 凭证引用 / dispatch · cancel · receipt" style="rounded=1;html=1;fillColor=#fff2e4;strokeColor=#ba864b;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="420" y="1100" width="710" height="90" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b&gt;执行 Worker / 容器&lt;/b&gt;&lt;br&gt;文件读写 · Shell · Playwright&lt;br&gt;进程回收 / 文件与网络隔离&lt;br&gt;主进程与执行环境分离" style="rounded=1;html=1;fillColor=#fff2e4;strokeColor=#ba864b;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="420" y="1260" width="330" height="115" as="geometry"/></mxCell><mxCell id="connectors" value="&lt;b&gt;外部连接器 / MCP&lt;/b&gt;&lt;br&gt;MCP stdio 或 Streamable HTTP&lt;br&gt;HTTP API · 云端工具&lt;br&gt;返回结构化结果与外部回执" style="rounded=1;html=1;fillColor=#fff2e4;strokeColor=#ba864b;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="800" y="1260" width="330" height="115" as="geometry"/></mxCell><mxCell id="session" value="&lt;b&gt;Session / Run / Invocation&lt;/b&gt;&lt;br&gt;历史分支 / 运行检查点&lt;br&gt;调用意图 / 参数摘要 / 回执&lt;br&gt;每个 Session 单写者" style="rounded=1;html=1;fillColor=#f2eff8;strokeColor=#8d80a7;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="35" y="430" width="300" height="120" as="geometry"/></mxCell><mxCell id="task" value="&lt;b&gt;Task / Plan&lt;/b&gt;&lt;br&gt;目标 / 约束 / 验收标准&lt;br&gt;计划版本 / 子任务关联&lt;br&gt;一项 Task 可以跨多次 Run" style="rounded=1;html=1;fillColor=#f2eff8;strokeColor=#8d80a7;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="35" y="595" width="300" height="115" as="geometry"/></mxCell><mxCell id="content" value="&lt;b&gt;Content Services&lt;/b&gt;&lt;br&gt;Memory：长期事实与偏好&lt;br&gt;Retrieval：导入、切块、来源&lt;br&gt;Artifact：文件、版本与验证&lt;br&gt;资料包通过 ContentPort 读取" style="rounded=1;html=1;fillColor=#f2eff8;strokeColor=#8d80a7;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="35" y="770" width="300" height="145" as="geometry"/></mxCell><mxCell id="store" value="&lt;b&gt;Storage Adapters&lt;/b&gt;&lt;br&gt;SQLite：状态 + 持久事件事务&lt;br&gt;文件：原始材料 / 产物 / 大输出&lt;br&gt;FTS5：可重建全文索引&lt;br&gt;JSONL：导出与诊断" style="rounded=1;html=1;fillColor=#f2eff8;strokeColor=#8d80a7;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="35" y="1070" width="300" height="145" as="geometry"/></mxCell><mxCell id="orchestration" value="&lt;b&gt;Orchestration&lt;/b&gt;&lt;br&gt;Workflow / Scheduler / Jobs&lt;br&gt;Subagents / Mailbox&lt;br&gt;统一调用 RunCommandPort&lt;br&gt;子任务独立 Session 与预算" style="rounded=1;html=1;fillColor=#f2eff8;strokeColor=#8d80a7;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="1205" y="235" width="300" height="140" as="geometry"/></mxCell><mxCell id="extensions" value="&lt;b&gt;Extension Host&lt;/b&gt;&lt;br&gt;manifest / API 版本 / 依赖排序&lt;br&gt;activate / dispose / 注册作用域&lt;br&gt;注册模型、工具、Skill 与 Hook&lt;br&gt;活动 Run 固定能力版本" style="rounded=1;html=1;fillColor=#f2eff8;strokeColor=#8d80a7;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="1205" y="430" width="300" height="145" as="geometry"/></mxCell><mxCell id="skills" value="&lt;b&gt;Skill Catalog + Hooks&lt;/b&gt;&lt;br&gt;Skill：摘要发现、按需读正文&lt;br&gt;Hook：固定时点、固定返回值&lt;br&gt;脚本动作进入执行治理" style="rounded=1;html=1;fillColor=#f2eff8;strokeColor=#8d80a7;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="1205" y="635" width="300" height="110" as="geometry"/></mxCell><mxCell id="credentials" value="&lt;b&gt;Credentials + Identity&lt;/b&gt;&lt;br&gt;本地身份 / 远端 OIDC&lt;br&gt;操作系统凭证库 / Secret&lt;br&gt;按调用范围注入凭证&lt;br&gt;原始密钥不进入上下文" style="rounded=1;html=1;fillColor=#f2eff8;strokeColor=#8d80a7;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="1205" y="810" width="300" height="135" as="geometry"/></mxCell><mxCell id="observe" value="&lt;b&gt;Observability + Evals&lt;/b&gt;&lt;br&gt;runId → stepId → toolCallId&lt;br&gt;结构化日志 / Trace / 指标&lt;br&gt;授权与执行审计独立持久化&lt;br&gt;任务质量 / 成本 / 时间基线&lt;br&gt;订阅脱敏事件，覆盖全部模块" style="rounded=1;html=1;fillColor=#f2eff8;strokeColor=#8d80a7;align=left;verticalAlign=top;spacing=15;fontSize=16;fontColor=#203c34" vertex="1" parent="1"><mxGeometry x="1205" y="1100" width="300" height="165" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
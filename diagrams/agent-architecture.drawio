<mxfile host="myagent" version="24.7.17"><diagram id="architecture" name="MyAgent 详细架构"><mxGraphModel page="1" pageWidth="1540" pageHeight="1500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame-core" value="后端进程内 · 稳定内核与显式接口" style="rounded=1;html=1;fillColor=#f5f9f5;strokeColor=#b7cbbd;dashed=1;verticalAlign=top;spacingTop=10;fontSize=16" vertex="1" parent="1"><mxGeometry x="385" y="385" width="780" height="600" as="geometry"/></mxCell><mxCell id="frame-exec" value="执行边界 · 通过 ExecutionPort 更换环境" style="rounded=1;html=1;fillColor=#fffaf3;strokeColor=#dcc39e;verticalAlign=top;spacingTop=10;fontSize=16" vertex="1" parent="1"><mxGeometry x="385" y="1050" width="780" height="355" as="geometry"/></mxCell><mxCell id="e0" value="命令 ↓ / SSE 事件 ↑" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=0" edge="1" parent="1" source="ui" target="app"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="180"/><mxPoint x="770" y="235"/></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=0" edge="1" parent="1" source="orchestration" target="app"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1205" y="290"/><mxPoint x="1100" y="290"/></Array></mxGeometry></mxCell><mxCell id="e2" value="启动 / 恢复 Run" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=0" edge="1" parent="1" source="app" target="runtime"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="345"/><mxPoint x="770" y="430"/></Array></mxGeometry></mxCell><mxCell id="e3" value="准备资料" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#4b7568;dashed=0" edge="1" parent="1" source="runtime" target="context"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="545"/><mxPoint x="585" y="605"/></Array><
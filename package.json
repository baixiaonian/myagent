{
  "name": "myagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @myagent/server dev",
    "dev:worker": "pnpm --filter @myagent/worker dev",
    "dev:cli": "pnpm --filter @myagent/cli dev",
    "build": "tsc -b && pnpm --filter @myagent/web build",
    "typecheck": "tsc -b && tsc -p tsconfig.tooling.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "tsc -b && vitest run",
    "check": "pnpm lint && pnpm check:architecture && pnpm check:docs && pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm build && pnpm check:release",
    "dev:types": "tsc -b --watch --preserveWatchOutput",
    "start": "node apps/server/dist/main.js",
    "test:e2e": "pnpm build && playwright test",
    "check:release": "node scripts/check-client-build.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:docker": "docker build -t myagent:acceptance-v1 . && node scripts/test-docker.mjs",
    "test:agent:live": "pnpm build && node scripts/test-agent-live.mjs",
    "test:execution:native": "pnpm build && MYAGENT_TEST_NATIVE=1 vitest run tests/execution/native.test.ts tests/execution/mcp.test.ts tests/skills/native.test.ts tests/hooks/native.test.ts tests/plugins/native.test.ts",
    "test:execution": "tsc -b && vitest run tests/execution",
    "test:execution:live": "pnpm build && node scripts/test-execution-live.mjs",
    "test:projects:live": "pnpm build && node scripts/test-projects-live.mjs",
    "test:memory": "tsc -b && vitest run tests/memory",
    "test:memory:live": "pnpm build && node scripts/test-memory-live.mjs",
    "test:context": "tsc -b && vitest run tests/context",
    "test:cache:replay": "node scripts/test-cache-replay.mjs",
    "test:context:live": "pnpm build && node scripts/test-context-live.mjs",
    "test:skills": "tsc -b && vitest run tests/skills",
    "test:skills:live": "pnpm build && node scripts/test-skills-live.mjs",
    "test:hooks": "tsc -b && vitest run tests/hooks",
    "test:hooks:live": "pnpm build && node scripts/test-hooks-live.mjs",
    "test:plugins": "tsc -b && vitest run tests/plugins",
    "test:plugins:live": "pnpm build && node scripts/test-plugins-live.mjs",
    "test:teams": "tsc -b && vitest run tests/teams",
    "test:teams:live": "pnpm build && node scripts/test-teams-live.mjs",
    "test:observability": "tsc -b && vitest run tests/observability",
    "test:observability:live": "pnpm build && node scripts/test-observability-live.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}

{
  "name": "myagent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "dev": "pnpm --filter @myagent/web dev",
    "dev:server": "pnpm --filter @myagent/server dev",
    "dev:worker": "pnpm --filter @myagent/worker dev",
    "dev:cli": "pnpm --filter @myagent/cli dev",
    "build": "tsc -b && pnpm --filter @myagent/web build",
    "typecheck": "tsc -b && tsc -p tsconfig.tooling.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "vitest run",
    "check": "pnpm lint && pnpm check:architecture && pnpm check:docs && pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm build",
    "dev:types": "tsc -b --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.13.3",
    "@biomejs/biome": "2.5.12",
    "tsx": "4.23.13",
    "vitest": "5.0.0"
  }
}
